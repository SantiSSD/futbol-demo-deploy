# ============================================================
# .env.example - plantilla de variables del stack demo
# Copiar a .env y completar. NO versionar el .env real.
# ============================================================

# Password del usuario "sa" de SQL Server de la DEMO (min 8 chars, mayus/minus/digito/simbolo).
DB_SA_PASSWORD=

# Clave de firma JWT de la DEMO (al menos 32 caracteres / 256 bits).
# Generar una nueva, ej: openssl rand -base64 48
JWT_KEY=

# Origen publico del FRONTEND demo (CORS). Debe incluir esquema https y NO barra final.
# Ej: https://demo.tudominio.com
DEMO_WEB_ORIGIN=

# URL publica de la API demo, que el navegador usara (se inlina en el build del frontend).
# Debe terminar en /api/v1 y coincidir con el subdominio de la API.
# Ej: https://api-demo.tudominio.com/api/v1
DEMO_API_URL=

# (Opcional) Rutas a los repos de la app si NO estan como hermanos con los nombres por defecto.
# BACKEND_PATH=../FutbolComplejoAPI
# FRONTEND_PATH=../Frontend_FutbolComplejo
